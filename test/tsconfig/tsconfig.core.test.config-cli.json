{
  "extends": "./tsconfig.core.test.shard.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../../.artifacts/tsgo-cache/core-test-config-cli.tsbuildinfo"
  },
  "include": [
    "../../src/config/**/*.test.ts",
    "../../src/config/**/*.test.tsx",
    "../../src/cli/**/*.test.ts",
    "../../src/cli/**/*.test.tsx",
    "../../src/hooks/**/*.test.ts",
    "../../src/hooks/**/*.test.tsx",
    "../../src/commands/doctor-lint.missing-load-path.test.ts",
    "../../src/commands/doctor-lint.plugin-path-inspection.test.ts",
    "../../src/commands/doctor/shared/bundled-plugin-load-paths.availability.test.ts"
  ],
  "exclude": [
    "../../node_modules",
    "../../dist",
    "../../**/dist/**",
    "../../src/cli/daemon-cli/**",
    "../../src/config/sessions/**"
  ]
}
